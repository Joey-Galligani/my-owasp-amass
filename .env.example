# Copy to .env and change the passwords before first `up`.
# The credentials are baked into the Postgres volume on first boot: changing
# them later requires `docker compose down -v` (destroys collected assets).

AMASS_VERSION=v5.1.1
POSTGRES_VERSION=17-alpine

# Host-side port for the engine API (loopback only). Container-internal it is
# always 4000; change this if something else on the host already owns the port.
ENGINE_HOST_PORT=14000

# Postgres superuser (maintenance / initdb only).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=postgres

# Role and database the Amass engine connects with. AMASS_DB_HOST must stay the
# compose service name so the engine and cli containers can reach it.
AMASS_DB_USER=amass
AMASS_DB_PASSWORD=change-me-amass
AMASS_DB_NAME=assetdb
AMASS_DB_HOST=assetdb
AMASS_DB_PORT=5432

# Optional: libpostal parsing server for street addresses found in WHOIS/RDAP
# records. Without it, address parsing is skipped silently.
# POSTAL_SERVER_HOST=libpostal
# POSTAL_SERVER_PORT=4001
